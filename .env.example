# Required for the glossary generator script
ANTHROPIC_API_KEY=your_api_key_here

# Required for the /contribute form's GitHub App integration (see docs/github-app-setup.md)
GITHUB_APP_ID=your_app_id
# Paste the full .pem contents; replace real newlines with \n if your .env format needs a single line
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
GITHUB_APP_INSTALLATION_ID=your_installation_id
GITHUB_REPO_OWNER=wandiamugo
GITHUB_REPO_NAME=bitcoin-plain-talk
